# Get a key at https://aistudio.google.com/app/apikey
# Vite only exposes env vars prefixed with VITE_ to client code, so the
# key must be named VITE_GEMINI_API_KEY (not just GEMINI_API_KEY).
#
# NOTE: this is a client-only SPA — any key placed here ships inside the
# browser bundle and is publicly visible. Fine for a demo/parody project;
# for production, proxy the Gemini call through a backend instead.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
